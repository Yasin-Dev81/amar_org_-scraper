# Amar.org.ir Scraper Environment Variables
# Copy to .env and fill in values as needed
# Load via: uv run --env-file .env python -m src.main run

# Optional: override config file path
# CONFIG_PATH=config/config.yaml

# Optional: override output base directory
# OUTPUT_DIR=.

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
